# Netlify caching rules.
#
# The default here was public,max-age=604800 for everything, which meant a
# visitor's browser held onto js/tour.js for a week. When the markup changed
# in a later deploy, that stale script ran against the new HTML, threw on an
# element that no longer existed, and left the tour dead on the page. Code and
# markup must always ship as a matched pair, so they revalidate every load.
# Photos keep a long cache because they are the bulk of the bytes and they get
# a new filename when they change.

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/netlify/functions/*
  Cache-Control: no-store

/colorwagonrentals/*
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800
